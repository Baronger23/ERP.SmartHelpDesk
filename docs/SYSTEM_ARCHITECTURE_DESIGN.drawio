      <mxCell id="lob_parser" value="&lt;b&gt;Document Parser &amp;amp; Chunking&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Trích xuất plain text kỹ thuật&lt;br/&gt;Cắt phân đoạn cố định 500 từ / 50 từ overlap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1045" y="160" width="205" height="75" as="geometry" /></mxCell>
      <mxCell id="lob_embed" value="&lt;b&gt;Text Embeddings Generator&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Mô hình text-embedding-3-small (1536d)&lt;br/&gt;Mã hóa toàn bộ các đoạn thành vector&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="1045" y="270" width="205" height="70" as="geometry" /></mxCell>
      <mxCell id="lob_vecdb" value="&lt;b&gt;Vector Index Storage&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;ChromaDB / Qdrant&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Lưu trữ vector cẩm nang&lt;br/&gt;Top-3 Cosine Retrieval&lt;br/&gt;Out-of-Domain Guard (&amp;ge;0.65)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=11;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="845" y="185" width="170" height="150" as="geometry" /></mxCell>
