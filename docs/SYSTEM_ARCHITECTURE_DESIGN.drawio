      <mxCell id="e_trigger_issue" value="TỰ ĐỘNG TẠO VÉ KHẨN (PM-to-CM Trigger)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2;dashed=1;fontColor=#DC2626;fontSize=10.5;fontStyle=1;" edge="1" source="ent_trigger" target="ent_issue" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="170" /><mxPoint x="470" y="170" /></Array></mxGeometry></mxCell>
      <mxCell id="e_tech_missue" value="Xuất phụ tùng thay thế" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;" edge="1" source="ent_tech" target="ent_issue_stock" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_missue_van" value="Nhánh A: Van Stock" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;" edge="1" source="ent_issue_stock" target="ent_van" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
