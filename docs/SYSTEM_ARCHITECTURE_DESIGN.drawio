      <mxCell id="t3" value="Technical Knowledge Base — Minimalist RAG Pipeline" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="200" y="25" width="1200" height="35" as="geometry" /></mxCell>
      <mxCell id="t3_sub" value="Alpha Industrial Services — Diagnostic &amp; Parts Retrieval Architecture for Field Technicians" style="text;html=1;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1200" height="25" as="geometry" /></mxCell>
      <mxCell id="box_ingest" value="QUY TRÌNH NẠP CẨM NANG KỸ THUẬT (DATA INGESTION PIPELINE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#0284C7;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontStyle=1;fontSize=13;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="80" y="120" width="440" height="730" as="geometry" /></mxCell>
      <mxCell id="rag_docs" value="&lt;b&gt;Cơ Sở Tài Liệu Nguồn (Knowledge Base)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;3 Cẩm nang kỹ thuật OEM mẫu công khai (PDF):&lt;br/&gt;1. Máy nén khí trục vít Hitachi 75kW (Hitachi-Manual.pdf)&lt;br/&gt;2. Chiller giải nhiệt nước Daikin 100RT (Daikin-Manual.pdf)&lt;br/&gt;3. Contactor Schneider TeSys LC1D (Schneider-LC1D.pdf)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="110" y="165" width="380" height="85" as="geometry" /></mxCell>
      <mxCell id="rag_extract" value="&lt;b&gt;1. Text Extraction &amp;amp; Normalization&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Trích xuất plain text sạch từ tài liệu PDF&lt;br/&gt;Loại bỏ header/footer lặp, chuẩn hóa bảng mã lỗi&lt;br/&gt;và thông số áp suất / nhiệt độ / dòng điện&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="110" y="290" width="380" height="75" as="geometry" /></mxCell>
      <mxCell id="rag_chunk" value="&lt;b&gt;2. Fixed Chunking Strategy (Cắt đoạn)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;Kích thước cố định: 500 từ (words) / đoạn&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Độ chồng lấn (overlap): 50 từ&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Giữ trọn vẹn mạch logic của bảng mã lỗi và sơ đồ đấu dây&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="110" y="405" width="380" height="85" as="geometry" /></mxCell>
      <mxCell id="rag_embed" value="&lt;b&gt;3. Text Embedding Model&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#059669&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;text-embedding-3-small (1536 dimensions)&lt;/b&gt;&lt;br/&gt;&lt;i&gt;(Hoặc bge-small-en-v1.5 cục bộ)&lt;/i&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Mã hóa từng đoạn văn bản thành vector không gian ngữ nghĩa&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="110" y="530" width="380" height="85" as="geometry" /></mxCell>
      <mxCell id="rag_index" value="&lt;b&gt;4. Vector Indexing &amp;amp; Metadata Tagging&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Lưu trữ vector kèm thẻ Metadata phong phú:&lt;br/&gt;&lt;code&gt;doc_id, equipment_model, part_numbers, section&lt;/code&gt;&lt;br/&gt;Xây dựng chỉ mục HNSW phục vụ tìm kiếm nhanh&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="110" y="655" width="380" height="85" as="geometry" /></mxCell>
      <mxCell id="rag_vecdb" value="&lt;b&gt;Vector Database&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27; style=&#x27;font-size:12px;&#x27;&gt;&lt;b&gt;ChromaDB / Qdrant&lt;/b&gt;&lt;br/&gt;(Local Container)&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Dense Vector Index&lt;br/&gt;Cosine Distance Metric&lt;br/&gt;HNSW Similarity Search&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontStyle=1;fontSize=12;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="575" y="430" width="200" height="160" as="geometry" /></mxCell>
      <mxCell id="box_query" value="QUY TRÌNH TRA CỨU SỰ CỐ CỦA KTV HIỆN TRƯỜNG (QUERY PIPELINE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#059669;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=12;fontStyle=1;fontSize=13;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="830" y="120" width="690" height="730" as="geometry" /></mxCell>
      <mxCell id="user_ktv" value="&lt;b&gt;Field Technician (KTV Hiện Trường)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Nhập hiện tượng / mã lỗi từ ứng dụng di động Chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="980" y="160" width="390" height="65" as="geometry" /></mxCell>
      <mxCell id="q_step1" value="&lt;b&gt;Câu Hỏi / Triệu Chứng (User Query):&lt;/b&gt;&lt;br/&gt;&lt;i&gt;&quot;Máy nén khí Hitachi 75kW báo lỗi E-04 nhiệt độ cao, cách xử lý?&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="980" y="260" width="390" height="55" as="geometry" /></mxCell>
      <mxCell id="q_step2" value="&lt;b&gt;Query Augmentation &amp;amp; Entity Extraction&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Trích xuất thực thể: &lt;code&gt;Model=Hitachi 75kW&lt;/code&gt;, &lt;code&gt;Fault=E-04&lt;/code&gt;, &lt;code&gt;Symptom=Overheat&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="980" y="340" width="390" height="55" as="geometry" /></mxCell>
      <mxCell id="q_step3" value="&lt;b&gt;Query Embedding Model&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Mã hóa truy vấn thành vector embedding cùng không gian với cẩm nang&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="390" height="55" as="geometry" /></mxCell>
      <mxCell id="q_step4" value="&lt;b&gt;Vector Retrieval (Cosine Similarity Search)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#059669&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;Truy vấn lấy Top-3 Chunks liên quan nhất&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Đối soát vector với ChromaDB để trích xuất đoạn giải mã lỗi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontSize=11;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="390" height="65" as="geometry" /></mxCell>
      <mxCell id="callout_rerank" value="&lt;b&gt;MVP DECISION:&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#92400E&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;&lt;b&gt;Loại Bỏ Reranker&lt;/b&gt;&lt;br/&gt;• Giảm độ trễ (&amp;lt; 1.5s)&lt;br/&gt;• Giảm chi phí tài nguyên&lt;br/&gt;• Đủ độ chính xác với sổ tay đơn ngành&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=10;align=center;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="1390" y="500" width="115" height="95" as="geometry" /></mxCell>
      <mxCell id="q_step5" value="&lt;b&gt;Out-of-Domain Guard (Chống Ảo Giác An Toàn)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#DC2626&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;Kiểm tra: Cosine Similarity &amp;ge; 0.65?&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#991B1B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Nếu &amp;lt; 0.65: Từ chối an toàn (&quot;Không tìm thấy trong sổ tay kỹ thuật,&lt;br/&gt;vui lòng liên hệ Đội trưởng hoặc Hãng sản xuất!&quot;)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=11;align=center;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="980" y="595" width="390" height="75" as="geometry" /></mxCell>
      <mxCell id="q_step6" value="&lt;b&gt;Prompt Assembly &amp;amp; Generation (LLM)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Ghép: System Prompt + Top-3 Chunks + Mã máy + Triệu chứng&lt;br/&gt;LLM sinh câu trả lời cấu trúc: Nguyên nhân, vị trí cảm biến, thao tác đo và mã linh kiện&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="980" y="695" width="390" height="75" as="geometry" /></mxCell>
      <mxCell id="e_rag_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="rag_docs" target="rag_extract" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_rag_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="rag_extract" target="rag_chunk" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_rag_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="rag_chunk" target="rag_embed" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_rag_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="rag_embed" target="rag_index" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_rag_to_db" value="Lưu trữ Vector &amp; Metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=2;fontColor=#0369A1;fontSize=10;" edge="1" source="rag_index" target="rag_vecdb" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_user" value="Gửi câu hỏi" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" source="user_ktv" target="q_step1" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_1_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="q_step1" target="q_step2" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_2_3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="q_step2" target="q_step3" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_3_4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="q_step3" target="q_step4" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_db_retrieve" value="Truy vấn Cosine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0284C7;strokeWidth=1.5;dashed=1;fontColor=#0369A1;fontSize=10;" edge="1" source="q_step4" target="rag_vecdb" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_4_5" value="Kiểm tra ngưỡng" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;" edge="1" source="q_step4" target="q_step5" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_q_5_6" value="Hợp lệ (&amp;ge;0.65)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" source="q_step5" target="q_step6" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_ans_user" value="Hướng Dẫn Xử Lý &amp;amp; Mã Phụ Tùng Đề Xuất" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=11;fontStyle=1;" edge="1" source="q_step6" target="user_ktv" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="730" /><mxPoint x="1430" y="190" /></Array></mxGeometry></mxCell>
      <mxCell id="f_tab3" value="&lt;b&gt;TỔNG KẾT NGUYÊN TẮC THIẾT KẾ RAG TINH GỌN (PRAGMATIC RAG INVARIANTS):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tài liệu nguồn:&lt;/b&gt; 3 Sổ tay kỹ thuật OEM công khai (Hitachi 75kW, Daikin 100RT, Schneider TeSys LC1D) phục vụ học thuật nội bộ.&lt;br/&gt;• &lt;b&gt;Chunking &amp;amp; Embedding:&lt;/b&gt; Cắt 500 từ cố định, gối đầu 50 từ. Embedding: text-embedding-3-small (hoặc bge-small-en-v1.5).&lt;br/&gt;• &lt;b&gt;Đánh đổi kỹ thuật (Trade-off):&lt;/b&gt; Lấy Top-3 Chunks, loại bỏ Reranking giúp hệ thống đạt độ trễ cực thấp (&amp;lt;1.5s), phù hợp môi trường mạng 4G hiện trường.&lt;br/&gt;• &lt;b&gt;Phòng vệ an toàn (Safety Guard):&lt;/b&gt; Cosine Similarity &amp;lt; 0.65 lập tức kích hoạt Out-of-Domain Rejection, tuyệt đối không suy diễn thông số điện/áp suất." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;spacingLeft=20;verticalAlign=middle;fontSize=11;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="80" y="880" width="1440" height="95" as="geometry" /></mxCell>
    </root>
  </mxGraphModel>
</diagram>
<diagram id="page-4" name="4. AI Agent Orchestration">
  <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#FFFFFF">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="t4" value="Enterprise AI Agent &amp; LOB ERP Integration Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="200" y="25" width="1200" height="35" as="geometry" /></mxCell>
      <mxCell id="t4_sub" value="Alpha Industrial Services (AIS) — Field Technician Copilot with Strict Safety Invariant (Draft Only)" style="text;html=1;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1200" height="25" as="geometry" /></mxCell>
      <mxCell id="v_line" value="" style="endArrow=none;dashed=1;html=1;strokeWidth=2;strokeColor=#CBD5E1;" vertex="0" parent="1"><mxGeometry x="790" y="110" width="0" height="780" as="geometry" /></mxCell>
      <mxCell id="frame_left" value="Orchestrate AI conversation with technician (Điều Phối Hội Thoại AI &amp;amp; KTV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#0284C7;strokeWidth=2;dashed=1;verticalAlign=bottom;align=center;spacingBottom=12;fontStyle=1;fontSize=12;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="710" height="770" as="geometry" /></mxCell>
      <mxCell id="ai_chat" value="&lt;b&gt;Chat Front-end&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27; style=&#x27;font-size:10.5px;&#x27;&gt;&lt;b&gt;Mobile PWA / Desk Copilot&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Giao diện hội thoại KTV hiện trường&lt;br/&gt;Nhập câu hỏi, nhận hướng dẫn,&lt;br/&gt;xem bản nháp phiếu xuất kho&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=2;fontSize=11;align=center;fontColor=#1E293B;shadow=1;" vertex="1" parent="1"><mxGeometry x="85" y="380" width="175" height="110" as="geometry" /></mxCell>
      <mxCell id="ai_core" value="&lt;b&gt;AI Orchestration Core&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#2563EB&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;LangChain / Agent Controller&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;• Phân tích ý định (Intent Recognition)&lt;br/&gt;• Điều phối RAG &amp;amp; Tool Calling&lt;br/&gt;• Kiểm duyệt ngưỡng an toàn Guardrails&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontSize=11;align=center;fontColor=#1E40AF;shadow=1;" vertex="1" parent="1"><mxGeometry x="315" y="380" width="200" height="110" as="geometry" /></mxCell>
      <mxCell id="ai_state" value="&lt;b&gt;Chat State &amp;amp; Session Memory&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Redis In-Memory / Local Session Store&lt;br/&gt;Lưu vết ngữ cảnh: &lt;code&gt;issue_id&lt;/code&gt;, &lt;code&gt;asset_id&lt;/code&gt;,&lt;br/&gt;mã linh kiện đang tra cứu, lịch sử chat&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=11;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="315" y="200" width="200" height="90" as="geometry" /></mxCell>
      <mxCell id="ai_llm" value="&lt;b&gt;LLM Reasoning Core&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#7C3AED&#x27; style=&#x27;font-size:11px;&#x27;&gt;&lt;b&gt;Gemini 2.5 / OpenAI / Claude API&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Suy luận chẩn đoán kỹ thuật&lt;br/&gt;Trích xuất tham số gọi Tool chuẩn xác&lt;br/&gt;Sinh hướng dẫn thao tác an toàn cho thợ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="315" y="570" width="200" height="95" as="geometry" /></mxCell>
      <mxCell id="ai_planner" value="&lt;b&gt;Planner &amp;amp; Task Decomposition&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Phân tách nhiệm vụ phức tạp:&lt;br/&gt;1. Tra cứu lỗi RAG → 2. Kiểm tra tồn xe&lt;br/&gt;→ 3. Đề xuất tạo nháp xuất kho&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="560" y="570" width="190" height="95" as="geometry" /></mxCell>
      <mxCell id="ai_tools" value="&lt;b&gt;AI Tool Registry &amp;amp; Enforcer&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#DC2626&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;4 TOOLS CHUẨN ĐƯỢC CẤP PHÉP:&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;get_stock_balance()&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;query_issue_sla()&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;create_draft_material_issue()&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;get_asset_maintenance_history()&lt;/code&gt;&lt;br/&gt;&lt;font color=&#x27;#B91C1C&#x27;&gt;&lt;b&gt;BẤT BIẾN: Chỉ tạo nháp Draft (0)&lt;/b&gt;&lt;/font&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=10.5;align=center;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="190" height="140" as="geometry" /></mxCell>
      <mxCell id="frame_right" value="Data Ingestion | Processing | Storage | ERPNext LOB Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#059669;strokeWidth=2;dashed=1;verticalAlign=bottom;align=center;spacingBottom=12;fontStyle=1;fontSize=12;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="820" y="110" width="720" height="770" as="geometry" /></mxCell>
