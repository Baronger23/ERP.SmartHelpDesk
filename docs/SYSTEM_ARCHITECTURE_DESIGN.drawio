      <mxCell id="mro_item2" value="&lt;b&gt;Stock Entry: Transfer&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Điều chuyển vật tư từ Kho Tổng lên xe&lt;br/&gt;KTV ký xác nhận trách nhiệm cá nhân&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="380" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="mro_item3" value="&lt;b&gt;Stock Entry: Material Issue&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Xuất linh kiện lắp vào máy khách&lt;br/&gt;Trừ tồn kho xe KTV tại hiện trường&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="437" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="mro_item4" value="&lt;b&gt;DocType: Bin (Tồn tức thời)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Kiểm soát actual_qty, reserved_qty&lt;br/&gt;Chống xuất âm kho trên từng xe KTV&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDE68A;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="815" y="494" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="mod_procure" value="&lt;b&gt;Procure-to-Stock&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#9A3412&#x27; style=&#x27;font-size:10px;&#x27;&gt;Phân hệ Cung ứng Bù tồn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=8;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="1050" y="285" width="230" height="270" as="geometry" /></mxCell>
      <mxCell id="proc_item1" value="&lt;b&gt;DocType: Item (Phụ tùng)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Mã linh kiện OEM (Hitachi, Schneider)&lt;br/&gt;Nhóm hàng, thông số, đơn vị tính&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="325" width="210" height="48" as="geometry" /></mxCell>
      <mxCell id="proc_item2" value="&lt;b&gt;Auto Reorder Level&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Tự động kích hoạt đề xuất mua hàng&lt;br/&gt;khi tồn kho chạm ngưỡng an toàn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="380" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="proc_item3" value="&lt;b&gt;Material Request &amp;amp; PO&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Quy trình mua hàng: Yêu cầu cấp hàng&lt;br/&gt;→ Đơn mua hàng NCC (Kim Long...)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="437" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="proc_item4" value="&lt;b&gt;Purchase Receipt &amp;amp; Nhập kho&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Nghiệm thu phụ tùng giao từ NCC&lt;br/&gt;Tăng số dư tồn kho trung tâm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FDBA74;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="494" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="mod_fin" value="&lt;b&gt;Finance &amp;amp; Billing&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#5B21B6&#x27; style=&#x27;font-size:10px;&#x27;&gt;Phân hệ Tài chính Dịch vụ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=8;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="1295" y="285" width="230" height="270" as="geometry" /></mxCell>
      <mxCell id="fin_item1" value="&lt;b&gt;custom_billing_type&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;&lt;b&gt;3 Nhãn Chi Phí Minh Bạch:&lt;/b&gt;&lt;br/&gt;• Under Warranty (AIS chịu 100%)&lt;br/&gt;• Billable (Khách hàng chi trả)&lt;br/&gt;• Goodwill (Hỗ trợ thiện chí lỗi lặp)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1305" y="325" width="210" height="68" as="geometry" /></mxCell>
      <mxCell id="fin_item2" value="&lt;b&gt;Sales Invoice Integration&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Tự động liên kết phiếu xuất kho vào&lt;br/&gt;hóa đơn dịch vụ cho ca Billable&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1305" y="400" width="210" height="48" as="geometry" /></mxCell>
      <mxCell id="fin_item3" value="&lt;b&gt;Approval Override Workflow&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Khóa quyền KTV tự chọn Goodwill.&lt;br/&gt;Chỉ Dispatcher/Manager được duyệt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1305" y="455" width="210" height="48" as="geometry" /></mxCell>
      <mxCell id="fin_item4" value="&lt;b&gt;Cost per Asset Aggregation&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Lũy kế chi phí sửa chữa theo từng máy&lt;br/&gt;Cảnh báo máy nuốt chi phí bảo hành&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DDD6FE;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1305" y="510" width="210" height="40" as="geometry" /></mxCell>
      <mxCell id="sub_srv_container" value="DỊCH VỤ XỬ LÝ NỀN BẤT ĐỒNG BỘ &amp;amp; TÍCH HỢP (ASYNC &amp;amp; INTEGRATION PLATFORM SERVICES)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1;fontSize=11;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontColor=#475569;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="315" y="565" width="1210" height="145" as="geometry" /></mxCell>
      <mxCell id="srv_scripts" value="&lt;b&gt;Server Scripts (Python)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9px;&#x27;&gt;DocEvents Hooks (before_insert)&lt;br/&gt;Skill-based Routing logic&lt;br/&gt;Callback detection &amp;amp; SLA calculation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="330" y="595" width="225" height="100" as="geometry" /></mxCell>
      <mxCell id="srv_workers" value="&lt;b&gt;Celery &amp;amp; Redis Workers&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9px;&#x27;&gt;Hàng đợi tác vụ bất đồng bộ&lt;br/&gt;Đồng hồ đếm ngược vi phạm SLA&lt;br/&gt;Worker xử lý gửi email cảnh báo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="595" width="225" height="100" as="geometry" /></mxCell>
      <mxCell id="srv_cron" value="&lt;b&gt;Cron Scheduler Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9px;&#x27;&gt;Vòng lặp định kỳ (Hourly / Daily)&lt;br/&gt;Tự động sinh lịch bảo dưỡng PM&lt;br/&gt;Kiểm tra ngưỡng đặt hàng Reorder&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="810" y="595" width="225" height="100" as="geometry" /></mxCell>
      <mxCell id="srv_audit" value="&lt;b&gt;Audit Trail &amp;amp; Versioning&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9px;&#x27;&gt;Lịch sử sửa đổi chứng từ (Timeline)&lt;br/&gt;Lưu vết đổi nhãn chi phí tài chính&lt;br/&gt;Kiểm toán truy vết trách nhiệm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1050" y="595" width="225" height="100" as="geometry" /></mxCell>
      <mxCell id="srv_gateway" value="&lt;b&gt;External API Gateway&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9px;&#x27;&gt;REST API (/api/resource)&lt;br/&gt;Tích hợp AI Agent Tool Calling&lt;br/&gt;Webhook gửi thông báo Zalo/Email&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1290" y="595" width="220" height="100" as="geometry" /></mxCell>
      <mxCell id="c_bot" value="TẦNG HẠ TẦNG LƯU TRỮ DỮ LIỆU &amp;amp; RUNTIME (INFRASTRUCTURE &amp;amp; DATA STORAGE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="60" y="745" width="1480" height="150" as="geometry" /></mxCell>
      <mxCell id="infra_mariadb" value="&lt;b&gt;MariaDB 10.6+ InnoDB Server&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#1E40AF&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;Cơ sở dữ liệu quan hệ giao dịch lõi (ACID)&lt;/b&gt;&lt;br/&gt;Lưu trữ bảng chuẩn Frappe: tabIssue, tabAsset, tabStock Entry, tabBin...&lt;br/&gt;Khóa ngoại, chỉ mục toàn vẹn &amp;amp; Transaction Rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontStyle=1;fontSize=11;align=center;fontColor=#1E40AF;" vertex="1" parent="1"><mxGeometry x="80" y="780" width="350" height="95" as="geometry" /></mxCell>
      <mxCell id="infra_redis" value="&lt;b&gt;Redis In-Memory Services&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#991B1B&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;3 Instance Redis Chuyên Biệt:&lt;/b&gt;&lt;br/&gt;• Redis Cache (Tăng tốc truy vấn Document &amp;amp; Session)&lt;br/&gt;• Redis Queue (Broker cho Celery Background Tasks)&lt;br/&gt;• Redis Socketio (Realtime Events Pub/Sub)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontStyle=1;fontSize=11;align=center;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="455" y="780" width="350" height="95" as="geometry" /></mxCell>
      <mxCell id="infra_bench" value="&lt;b&gt;Frappe Bench Application Runtime&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#5B21B6&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;Python 3.11 WSGI / Gunicorn Web Workers&lt;/b&gt;&lt;br/&gt;Node.js / Socket.io Server cho cập nhật Realtime Desk&lt;br/&gt;Supervisor quản lý tiến trình nền &amp;amp; Bench CLI Admin&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontStyle=1;fontSize=11;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="830" y="780" width="350" height="95" as="geometry" /></mxCell>
      <mxCell id="infra_docker" value="&lt;b&gt;Docker Local Deployment Platform&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;Môi trường Container hóa Local trên Máy chủ&lt;/b&gt;&lt;br/&gt;Docker Compose điều phối các dịch vụ ERPNext &amp;amp; MariaDB&lt;br/&gt;Named Volumes bảo toàn dữ liệu CSDL &amp;amp; thư mục Public Files&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontStyle=1;fontSize=11;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="1205" y="780" width="320" height="95" as="geometry" /></mxCell>
      <mxCell id="leg1" value="&lt;b&gt;QUY CHUẨN MÀU PHÂN HỆ:&lt;/b&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🟦 &lt;font color=&#x27;#2563EB&#x27;&gt;&lt;b&gt;Helpdesk &amp;amp; SLA&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🟩 &lt;font color=&#x27;#059669&#x27;&gt;&lt;b&gt;CMMS &amp;amp; Thiết Bị&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🟨 &lt;font color=&#x27;#D97706&#x27;&gt;&lt;b&gt;Kho MRO &amp;amp; Xe KTV&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🟧 &lt;font color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;Mua Hàng Cung Ứng&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🟪 &lt;font color=&#x27;#7C3AED&#x27;&gt;&lt;b&gt;Tài Chính Dịch Vụ&lt;/b&gt;&lt;/font&gt; &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; 🔘 &lt;font color=&#x27;#475569&#x27;&gt;&lt;b&gt;Hạ Tầng Nền Tảng&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;fontSize=11;align=center;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="60" y="910" width="1480" height="40" as="geometry" /></mxCell>
      <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#3B82F6;strokeWidth=1.5;" edge="1" source="client_web" target="mod_hd" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;" edge="1" source="client_pwa" target="mod_cmms" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;" edge="1" source="client_dispatch" target="mod_hd" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#EA580C;strokeWidth=1.5;" edge="1" source="client_wh" target="mod_mro" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" source="client_bill" target="mod_fin" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e6" value="REST Tool Calls" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=1.5;dashed=1;fontColor=#2563EB;fontSize=10;" edge="1" source="client_ai" target="srv_gateway" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
      <mxCell id="e_core_db" value="ACID Transactions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;fontColor=#64748B;fontSize=10;" edge="1" source="c_mid" target="infra_mariadb" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
