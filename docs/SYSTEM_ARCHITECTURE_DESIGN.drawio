      <mxCell id="cmms_item4" value="&lt;b&gt;PM-to-CM Trigger Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#065F46&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;&lt;b&gt;Cầu nối khẩn cấp:&lt;/b&gt; Phát hiện linh kiện sắp nổ/hỏng → Tự động tạo Issue mới&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="497" width="210" height="47" as="geometry" /></mxCell>
