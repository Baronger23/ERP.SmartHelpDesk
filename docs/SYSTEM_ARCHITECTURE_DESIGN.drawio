<diagram id="page-3" name="3. Minimalist RAG Pipeline">
  <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#FFFFFF">
    <root>
      <mxCell id="0" />
