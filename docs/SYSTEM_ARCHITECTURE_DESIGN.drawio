<diagram id="page-2" name="2. Logical Architecture">
  <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" background="#FFFFFF">
    <root>
      <mxCell id="0" />
      <mxCell id="1" parent="0" />
      <mxCell id="t2" value="Smart HelpDesk &amp; Maintenance Logical Architecture" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="200" y="25" width="1200" height="35" as="geometry" /></mxCell>
      <mxCell id="t2_sub" value="Alpha Industrial Services (AIS) — Entity Relationships &amp; Operational Lifecycle Workflows" style="text;html=1;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="1200" height="25" as="geometry" /></mxCell>
      <mxCell id="leg2" value="&lt;b&gt;QUY ƯỚC MÀU LUỒNG NGHIỆP VỤ:&lt;/b&gt;&lt;br/&gt;🟧 &lt;font color=&#x27;#EA580C&#x27;&gt;&lt;b&gt;Sự Cố &amp;amp; Hiện Trường (Incident / Field Service)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;🟩 &lt;font color=&#x27;#059669&#x27;&gt;&lt;b&gt;Bảo Trì Định Kỳ (CMMS Lifecycle)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;🟦 &lt;font color=&#x27;#0284C7&#x27;&gt;&lt;b&gt;Vật Tư &amp;amp; Kho Xe KTV (MRO Supply Chain)&lt;/b&gt;&lt;/font&gt;&lt;br/&gt;🟪 &lt;font color=&#x27;#7C3AED&#x27;&gt;&lt;b&gt;Tài Chính Dịch Vụ (Billing Realization)&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=11;align=left;spacingLeft=12;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="1240" y="35" width="300" height="105" as="geometry" /></mxCell>
      <mxCell id="root_asset" value="&lt;b&gt;CUSTOMER &amp;amp; ASSET (ROOT ENTITY)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Khách Hàng:&lt;/b&gt; Doanh nghiệp B2B (Tân Á, Song Long...)&lt;br/&gt;&lt;b&gt;Hợp Đồng Dịch Vụ:&lt;/b&gt; Hạng VIP vs Standard&lt;br/&gt;&lt;b&gt;Thiết Bị Khách:&lt;/b&gt; Chiller, Máy nén khí, Tủ điện MSB&lt;br/&gt;&lt;br/&gt;&lt;font color=&#x27;#0369A1&#x27;&gt;&lt;b&gt;Polyfill Trade-off:&lt;/b&gt;&lt;br/&gt;• &lt;code&gt;is_customer_equipment = 1&lt;/code&gt;&lt;br/&gt;• &lt;code&gt;calculate_depreciation = 0&lt;/code&gt; (Khóa khấu hao)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;strokeWidth=2.5;fontStyle=1;fontSize=12;align=center;fontColor=#0F172A;shadow=1;" vertex="1" parent="1"><mxGeometry x="660" y="310" width="280" height="160" as="geometry" /></mxCell>
      <mxCell id="ent_issue" value="&lt;b&gt;DocType: Issue (Vé sự cố)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Tiếp nhận báo hỏng từ Portal/Dispatcher&lt;br/&gt;Mức ưu tiên: Urgent, High, Medium, Low&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=11;align=center;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="360" y="310" width="220" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_sla" value="&lt;b&gt;Ma Trận SLA 2 Chiều (PP-02)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;VIP Tân Á:&lt;/b&gt; 30p phản hồi / 4h xử lý (24/7)&lt;br/&gt;&lt;b&gt;Standard:&lt;/b&gt; 2h phản hồi / 12h (Hành chính)&lt;br/&gt;Tự động dừng đồng hồ ngoài giờ trực&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="80" y="215" width="230" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_routing" value="&lt;b&gt;Skill-based Routing (PP-01)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Server Script trên hook &lt;code&gt;before_insert&lt;/code&gt;&lt;br/&gt;Lọc: &lt;code&gt;custom_asset_category&lt;/code&gt; ↔ Kỹ năng KTV&lt;br/&gt;Chiller ↔ Điện lạnh, Tủ MSB ↔ Điện CN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="80" y="335" width="230" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_tech" value="&lt;b&gt;Field Technician (KTV Hiện trường)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;KTV nhận việc trên Mobile PWA&lt;br/&gt;Tiếp cận hiện trường → Cập nhật In Progress&lt;br/&gt;Sửa chữa, thay phụ tùng → Hoàn thành vé&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=11;align=center;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="360" y="445" width="220" height="80" as="geometry" /></mxCell>
      <mxCell id="ent_callback" value="&lt;b&gt;Callback &amp;amp; FTFR Tracking (PP-03)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Phát hiện sự cố tái phát trong 7-14 ngày&lt;br/&gt;Bật cờ &lt;code&gt;custom_has_callback = 1&lt;/code&gt;&lt;br/&gt;Liên kết &lt;code&gt;custom_related_issue&lt;/code&gt; trỏ vé cũ&lt;br/&gt;Đo chỉ số First-Time Fix Rate (FTFR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=1.5;fontSize=10;align=center;fontColor=#9A3412;" vertex="1" parent="1"><mxGeometry x="80" y="455" width="230" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_pm" value="&lt;b&gt;Asset Maintenance (Kế hoạch PM)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Lịch bảo dưỡng định kỳ (1 Tháng, 3 Tháng, 6 Tháng)&lt;br/&gt;Ngăn ngừa sự cố đột xuất dừng chuyền&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="1020" y="310" width="220" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_tasks" value="&lt;b&gt;Checklist Hạng Mục Bảo Trì&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;• Đo dòng điện tải &amp;amp; điện trở cách điện&lt;br/&gt;• Kiểm tra mức dầu, thay phin lọc khí&lt;br/&gt;• Vệ sinh giàn ngưng tụ Chiller&lt;br/&gt;• Siết ốc lực bu-lông thanh cái tủ MSB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=10;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="1290" y="215" width="230" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_downtime" value="&lt;b&gt;Asset Downtime &amp;amp; MTBF&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Theo dõi thời gian ngừng hoạt động&lt;br/&gt;Tính toán MTBF (Mean Time Between Failures)&lt;br/&gt;và MTTR (Mean Time To Repair)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="1290" y="335" width="230" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_log" value="&lt;b&gt;Asset Maintenance Log&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Nhật ký thực hiện bảo trì định kỳ&lt;br/&gt;Ghi nhận trạng thái: Hoàn thành / Phát hiện lỗi&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;align=center;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="1020" y="445" width="220" height="80" as="geometry" /></mxCell>
      <mxCell id="ent_trigger" value="&lt;b&gt;PM-to-CM Trigger Engine (PP-04)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#065F46&#x27; style=&#x27;font-size:10.5px;&#x27;&gt;&lt;b&gt;CẦU NỐI ĐỘT PHÁ:&lt;/b&gt;&lt;br/&gt;Phát hiện bất thường khi khám định kỳ&lt;br/&gt;&lt;b&gt;→ TỰ ĐỘNG SINH ISSUE KHẨN&lt;/b&gt;&lt;br/&gt;Gán cam kết SLA để xử lý ngay!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=10.5;align=center;fontColor=#065F46;shadow=1;" vertex="1" parent="1"><mxGeometry x="1290" y="445" width="230" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_issue_stock" value="&lt;b&gt;Stock Entry: Material Issue (Xuất phụ tùng)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;KTV xuất linh kiện lắp vào máy khách (Lọc dầu, Contactor, Rơ le...)&lt;br/&gt;Liên kết chặt chẽ: &lt;code&gt;custom_issue&lt;/code&gt; &amp;amp; &lt;code&gt;custom_asset&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#0284C7;strokeWidth=2;fontSize=11;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="660" y="530" width="280" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_van" value="&lt;b&gt;Kho Xe KTV (Van Stock di động - PP-08)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0284C7&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;[NHÁNH A: FAST-PATH (100% SLA)]&lt;/b&gt;&lt;br/&gt;Xe KTV có sẵn phụ tùng → Xuất thẳng vào máy&lt;br/&gt;Xác lập trách nhiệm cá nhân KTV phụ trách&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=10.5;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="360" y="650" width="240" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_transfer" value="&lt;b&gt;Stock Entry: Material Transfer&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#0284C7&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;[NHÁNH B: FALLBACK (NGUY CƠ TRỄ)]&lt;/b&gt;&lt;br/&gt;Xe hết hàng → Thủ kho cấp khẩn lên xe KTV&lt;br/&gt;KTV chạy về kho lấy hoặc xe ứng cứu hỗ trợ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="360" y="780" width="240" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_center_wh" value="&lt;b&gt;Kho Tổng Trung Tâm (Central WH)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Kho chính lưu trữ phụ tùng, linh kiện&lt;br/&gt;Cung ứng điều chuyển cho các kho xe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;fontSize=11;align=center;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="80" y="715" width="230" height="80" as="geometry" /></mxCell>
      <mxCell id="ent_bin" value="&lt;b&gt;DocType: Bin &amp;amp; Auto Reorder (PP-09)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#92400E&#x27; style=&#x27;font-size:10px;&#x27;&gt;Kiểm soát actual_qty thời gian thực từng kho&lt;br/&gt;&lt;b&gt;Tự kích hoạt Reorder khi chạm ngưỡng an toàn&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="665" y="655" width="270" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_po" value="&lt;b&gt;Material Request &amp;amp; Purchase Order&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#92400E&#x27; style=&#x27;font-size:10px;&#x27;&gt;Quy trình mua hàng: Đề xuất cấp hàng&lt;br/&gt;→ Đơn mua hàng NCC (Kim Long, Minh Phát...)&lt;br/&gt;→ Nghiệm thu nhập kho bù tồn&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="665" y="780" width="270" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_billing" value="&lt;b&gt;Billing Classification Engine (PP-07)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#5B21B6&#x27; style=&#x27;font-size:10px;&#x27;&gt;Cây quyết định phân loại chi phí dịch vụ kỹ thuật&lt;br/&gt;Trường chọn: &lt;code&gt;custom_billing_type&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="1020" y="550" width="240" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_warr" value="&lt;b&gt;[ UNDER WARRANTY ]&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Máy trong hạn bảo hành (&amp;le; 12 tháng)&lt;br/&gt;&lt;b&gt;AIS chịu 100% chi phí (0đ thu khách)&lt;/b&gt;&lt;br/&gt;Định mức ngân sách theo hợp đồng&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="1020" y="665" width="240" height="75" as="geometry" /></mxCell>
      <mxCell id="ent_billable" value="&lt;b&gt;[ BILLABLE TO CUSTOMER ]&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Hết hạn BH / Vận hành quá tải, chập lưới&lt;br/&gt;&lt;b&gt;→ KẾT XUẤT HÓA ĐƠN SALES INVOICE&lt;/b&gt;&lt;br/&gt;Thu tiền khách (VD: Hóa đơn 3.800.000đ tủ MSB)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=10.5;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="1290" y="665" width="240" height="85" as="geometry" /></mxCell>
      <mxCell id="ent_goodwill" value="&lt;b&gt;[ GOODWILL - THIỆN CHÍ ]&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;Ca sửa tái phát (Callback) do lỗi KTV&lt;br/&gt;&lt;b&gt;AIS chịu chi phí phạt lỗi nội bộ&lt;/b&gt;&lt;br/&gt;Bảo vệ uy tín thương hiệu đối với khách VIP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=10.5;align=center;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="1020" y="785" width="240" height="80" as="geometry" /></mxCell>
      <mxCell id="ent_approval" value="&lt;b&gt;Approval Override Workflow&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:10px;&#x27;&gt;&lt;b&gt;Cơ chế kiểm soát gian lận:&lt;/b&gt;&lt;br/&gt;KTV chỉ có quyền ĐỀ XUẤT.&lt;br/&gt;Chỉ &lt;b&gt;Dispatcher / Service Manager&lt;/b&gt; có quyền duyệt&lt;br/&gt;đổi từ Billable sang Goodwill kèm lý do kiểm toán!&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=1.5;fontSize=10;align=center;fontColor=#991B1B;" vertex="1" parent="1"><mxGeometry x="1290" y="785" width="240" height="85" as="geometry" /></mxCell>
