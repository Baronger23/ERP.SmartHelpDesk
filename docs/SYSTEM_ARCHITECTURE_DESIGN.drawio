      <mxCell id="hd_item1" value="&lt;b&gt;DocType: Issue&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Mã vé, Khách hàng, Thiết bị, Mức độ ưu tiên (Urgent/High/Med/Low)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="325" y="325" width="210" height="48" as="geometry" /></mxCell>
      <mxCell id="hd_item2" value="&lt;b&gt;Ma Trận SLA 2 Chiều&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Hạng VIP: 30p phản hồi / 4h xử lý (24/7)&lt;br/&gt;Standard: 2h phản hồi / 12h (Hành chính)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="325" y="380" width="210" height="52" as="geometry" /></mxCell>
      <mxCell id="hd_item3" value="&lt;b&gt;Skill-based Routing Engine&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Server Script khớp Category ↔ Kỹ năng KTV (Cơ điện, Lạnh, Tủ điện)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="325" y="439" width="210" height="50" as="geometry" /></mxCell>
      <mxCell id="hd_item4" value="&lt;b&gt;Callback &amp;amp; FTFR Tracking&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Theo dõi sự cố tái phát trong 7-14 ngày&lt;br/&gt;Bật cờ &lt;code&gt;custom_has_callback = 1&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#93C5FD;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="325" y="496" width="210" height="48" as="geometry" /></mxCell>
      <mxCell id="mod_cmms" value="&lt;b&gt;CMMS Maintenance&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#065F46&#x27; style=&#x27;font-size:10px;&#x27;&gt;Phân hệ Quản lý Thiết bị&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1.5;fontStyle=1;fontSize=12;verticalAlign=top;align=center;spacingTop=8;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="560" y="285" width="230" height="270" as="geometry" /></mxCell>
      <mxCell id="cmms_item1" value="&lt;b&gt;DocType: Asset (Máy khách)&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;&lt;b&gt;Polyfill Trade-off:&lt;/b&gt; Tắt khấu hao&lt;br/&gt;(&lt;code&gt;calculate_depreciation = 0&lt;/code&gt;)&lt;br/&gt;Gắn cờ &lt;code&gt;is_customer_equipment = 1&lt;/code&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="325" width="210" height="55" as="geometry" /></mxCell>
      <mxCell id="cmms_item2" value="&lt;b&gt;Asset Maintenance Plan&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#64748B&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Lịch bảo dưỡng định kỳ 1M, 3M, 6M&lt;br/&gt;Checklist hạng mục tra dầu, đo tải&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A7F3D0;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="570" y="387" width="210" height="48" as="geometry" /></mxCell>
