      <mxCell id="sec_rbac" value="&lt;b&gt;RBAC &amp;amp; User Permission&lt;/b&gt;&lt;br/&gt;&lt;font color=&#x27;#475569&#x27; style=&#x27;font-size:9.5px;&#x27;&gt;Phân quyền vai trò nghiêm ngặt&lt;br/&gt;Khách chỉ xem máy/vé của mình&lt;br/&gt;KTV chỉ xem vé được phân công&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="95" y="320" width="190" height="65" as="geometry" /></mxCell>
