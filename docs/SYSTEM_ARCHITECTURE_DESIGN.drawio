      <mxCell id="e_r_pm" value="Kế hoạch định kỳ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2;" edge="1" source="root_asset" target="ent_pm" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
