{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "state_version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "RUNNING",
        "WAITING_INPUT",
        "WAITING_APPROVAL",
        "RESUMING",
        "VERIFYING"
      ]
    },
    "plan_version": {
      "type": "integer",
      "minimum": 1
    },
    "pending_step_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "pending_command_keys": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    },
    "counters": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "integer",
          "minimum": 0
        },
        "tool_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "model_turns": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "integer",
          "minimum": 0
        },
        "active_ms": {
          "type": "integer",
          "minimum": 0
        },
        "resumes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "steps",
        "tool_attempts",
        "model_turns",
        "tokens",
        "active_ms",
        "resumes"
      ],
      "additionalProperties": false
    },
    "resume_condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "APPROVAL_DECISION"
            },
            "approval_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "approval_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "INPUT"
            },
            "input_request_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "input_request_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "RECOVERY"
            },
            "command_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "command_ids"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "run_id",
    "state_version",
    "status",
    "plan_version",
    "pending_step_ids",
    "pending_command_keys",
    "evidence_refs",
    "counters",
    "resume_condition"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "WAITING_APPROVAL"
          }
        }
      },
      "then": {
        "properties": {
          "resume_condition": {
            "properties": {
              "kind": {
                "const": "APPROVAL_DECISION"
              }
            }
          }
        }
      }
    }
  ]
}
