{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "command_type": {
      "type": "string",
      "enum": [
        "MATERIAL_ALLOCATION_DRAFT",
        "MATERIAL_REQUEST_DRAFT",
        "WORK_ORDER_DRAFT",
        "TRIAGE_RECOMMENDATION",
        "DISPATCH_RECOMMENDATION"
      ]
    },
    "target_domain": {
      "type": "string",
      "enum": [
        "M02",
        "M03",
        "M05",
        "M06"
      ]
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "company_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "customer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload": {},
    "expected_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "tool_version": {
      "const": "1.0.0"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "uniqueItems": true
    }
  },
  "required": [
    "proposal_id",
    "run_id",
    "command_type",
    "target_domain",
    "actor_id",
    "company_id",
    "customer_id",
    "site_id",
    "payload",
    "expected_versions",
    "policy_version",
    "tool_version",
    "evidence_refs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "MATERIAL_ALLOCATION_DRAFT"
          }
        }
      },
      "then": {
        "properties": {
          "target_domain": {
            "const": "M05"
          },
          "payload": {
            "type": "object",
            "properties": {
              "work_order_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "equipment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "item_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "warehouse_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "quantity": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"
              },
              "uom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "work_order_id",
              "equipment_id",
              "item_code",
              "warehouse_id",
              "quantity",
              "uom",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "MATERIAL_REQUEST_DRAFT"
          }
        }
      },
      "then": {
        "properties": {
          "target_domain": {
            "const": "M06"
          },
          "payload": {
            "type": "object",
            "properties": {
              "work_order_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "equipment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "item_code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "warehouse_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "quantity": {
                "type": "string",
                "pattern": "^[0-9]+(\\.[0-9]{1,3})?$"
              },
              "uom": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "work_order_id",
              "equipment_id",
              "item_code",
              "warehouse_id",
              "quantity",
              "uom",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "WORK_ORDER_DRAFT"
          }
        }
      },
      "then": {
        "properties": {
          "target_domain": {
            "const": "M03"
          },
          "payload": {
            "type": "object",
            "properties": {
              "work_source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "equipment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "package_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "generation_version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "work_source_id",
              "equipment_id",
              "package_key",
              "generation_version",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "TRIAGE_RECOMMENDATION"
          }
        }
      },
      "then": {
        "properties": {
          "target_domain": {
            "const": "M02"
          },
          "payload": {
            "type": "object",
            "properties": {
              "request_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "recommendation_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "request_id",
              "recommendation_ref",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command_type": {
            "const": "DISPATCH_RECOMMENDATION"
          }
        }
      },
      "then": {
        "properties": {
          "target_domain": {
            "const": "M03"
          },
          "payload": {
            "type": "object",
            "properties": {
              "work_order_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "eligible_technician_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "slot_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "reason_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "work_order_id",
              "eligible_technician_id",
              "slot_ref",
              "reason_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
